# ─── CyberShield server environment ───────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env. Keys stay on the server only.

PORT=5001
# Comma-separated list of allowed browser origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# VirusTotal → https://www.virustotal.com/gui/my-apikey   (free: ~4 req/min, 500/day)
VIRUSTOTAL_API_KEY=

# Google Safe Browsing v4 → Google Cloud Console → APIs & Services → enable "Safe Browsing API" → Credentials
SAFE_BROWSING_API_KEY=

# Gemini → https://aistudio.google.com/app/apikey
# Free tier is per Google Cloud project. You may list SEVERAL keys separated by commas
# (from different projects); the server switches keys when one hits its quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Fast model for short result explanations (message analysis still uses GEMINI_MODEL)
GEMINI_EXPLAIN_MODEL=gemini-3.5-flash-lite

# AbuseIPDB → https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Rate limit: max scans per window per IP (defaults shown)
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_MAX=20
