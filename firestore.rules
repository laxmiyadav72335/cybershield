rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public live counter shown on the Home page. Anyone may read it and
    // increment totalScans by exactly 1 — nothing else. No other data is stored.
    match /stats/global {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['totalScans'])
                    && request.resource.data.totalScans == 1;
      allow update: if request.resource.data.keys().hasOnly(['totalScans'])
                    && request.resource.data.totalScans == resource.data.totalScans + 1;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
